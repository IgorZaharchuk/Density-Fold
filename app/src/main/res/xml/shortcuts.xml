<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="density_open"
        android:enabled="true"
        android:icon="@drawable/ic_action_open"
        android:shortcutShortLabel="@string/shortcut_open_short"
        android:shortcutLongLabel="@string/shortcut_open_long"
        android:shortcutDisabledMessage="@string/shortcut_open_disabled">
        <intent
            android:action="com.densityfold.action.OPEN"
            android:targetPackage="com.densityfold"
            android:targetClass="com.densityfold.OpenActionActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="density_closed"
        android:enabled="true"
        android:icon="@drawable/ic_action_closed"
        android:shortcutShortLabel="@string/shortcut_closed_short"
        android:shortcutLongLabel="@string/shortcut_closed_long"
        android:shortcutDisabledMessage="@string/shortcut_closed_disabled">
        <intent
            android:action="com.densityfold.action.CLOSED"
            android:targetPackage="com.densityfold"
            android:targetClass="com.densityfold.ClosedActionActivity" />
    </shortcut>
</shortcuts>
