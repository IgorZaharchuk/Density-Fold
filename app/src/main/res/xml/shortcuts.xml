<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="density_open"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="Открыто"
        android:shortcutLongLabel="Применить DPI внутреннего экрана"
        android:shortcutDisabledMessage="Открыто">
        <intent
            android:action="com.densityfold.action.OPEN"
            android:targetPackage="com.densityfold"
            android:targetClass="com.densityfold.OpenActionActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="density_closed"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="Закрыто"
        android:shortcutLongLabel="Применить DPI внешнего экрана"
        android:shortcutDisabledMessage="Закрыто">
        <intent
            android:action="com.densityfold.action.CLOSED"
            android:targetPackage="com.densityfold"
            android:targetClass="com.densityfold.ClosedActionActivity" />
    </shortcut>
</shortcuts>
